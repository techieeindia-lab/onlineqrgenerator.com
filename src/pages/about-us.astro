---
import Layout from '../layouts/Layout.astro';
import Header from '../components/mainpage/Header.astro';
import Footer from '../components/mainpage/Footer.astro';
import { translations } from '../i18n/translations';
import { getSubpageData } from '../i18n/subpageData';

const locale = Astro.currentLocale || 'en';
const t = translations[locale] || translations.en;
const sub = getSubpageData(locale).about;

function localizePath(path: string): string {
  return locale === 'en' ? path : `/${locale}${path}`;
}
---

<Layout title={`${sub.title} | ${t.title}`} description={sub.metaDesc}>
  <!-- Background Grid & Premium Blur Glows Overlay -->
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
    <div class="absolute inset-0 grid-pattern opacity-60 dark:opacity-30"></div>
    <div class="absolute -top-40 -right-40 w-[600px] h-[600px] rounded-full bg-gradient-to-br from-[#ff1b6b]/15 to-[#eca0ff]/15 blur-[120px] dark:from-[#ff1b6b]/10 dark:to-[#eca0ff]/10"></div>
    <div class="absolute top-[40%] -left-60 w-[500px] h-[500px] rounded-full bg-gradient-to-tr from-indigo-500/10 to-[#eca0ff]/10 blur-[100px] dark:from-indigo-900/5 dark:to-[#eca0ff]/5"></div>
  </div>

  <Header />

  <main class="relative z-10 flex-1 max-w-4xl mx-auto px-4 py-16 w-full flex flex-col gap-16">
    <!-- Hero Section -->
    <div class="flex flex-col items-center text-center gap-4">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 text-[10px] font-mono font-semibold uppercase tracking-wider text-[#ff1b6b] bg-[#ff1b6b]/10 border border-[#ff1b6b]/20 rounded-full">
        {sub.badge}
      </span>
      <h1 class="text-4xl md:text-5xl font-sans font-bold tracking-tight text-ink max-w-2xl leading-[1.1] mt-2">
        {sub.heading}
      </h1>
      <p class="text-base text-body max-w-xl mt-2 leading-relaxed">
        {sub.subheading}
      </p>
    </div>

    <!-- Core Values Grid -->
    <div class="flex flex-col gap-8">
      <h2 class="text-xs font-mono uppercase tracking-wider text-mute text-center md:text-left">{sub.principlesTitle}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {sub.principles.map((item, idx) => (
          <div class="bg-canvas border border-hairline hover:border-hairline-strong rounded-2xl p-6 transition-all duration-300 shadow-xs flex flex-col gap-3">
            <div class={`w-10 h-10 rounded-lg flex items-center justify-center ${
              idx === 0 ? 'bg-blue-500/10 text-blue-600 dark:text-blue-400' :
              idx === 1 ? 'bg-[#ff1b6b]/10 text-[#ff1b6b]' :
              idx === 2 ? 'bg-purple-500/10 text-purple-600 dark:text-purple-400' :
              'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400'
            }`}>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                {idx === 0 && <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.57-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />}
                {idx === 1 && <path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" />}
                {idx === 2 && <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />}
                {idx === 3 && <path stroke-linecap="round" stroke-linejoin="round" d="M9.53 16.122l9.37-9.37m-2.829-.001l2.828.001-.001 2.828m-6.28 7.371a3.96 3.96 0 01-1.42 2.748 3.962 3.962 0 01-5.46-.227 3.962 3.962 0 01-.227-5.46 3.96 3.96 0 012.748-1.417M14.07 12L12 14.07M20.25 19.5v-1.875a1.875 1.875 0 00-1.875-1.875H16.5" />}
              </svg>
            </div>
            <h3 class="font-sans font-bold text-lg text-ink">{item.title}</h3>
            <p class="text-sm text-body leading-relaxed">
              {item.desc}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Tech Stack / Architectural Highlight -->
    <div class="bg-canvas border border-hairline rounded-2xl p-8 transition-all duration-300 flex flex-col md:flex-row items-center gap-8 relative overflow-hidden">
      <!-- Background subtle gradient -->
      <div class="absolute -right-20 -bottom-20 w-80 h-80 rounded-full bg-gradient-to-tr from-[#ff1b6b]/10 to-[#eca0ff]/10 blur-[60px] pointer-events-none"></div>

      <div class="flex-1 flex flex-col gap-3">
        <span class="text-[9px] font-mono uppercase tracking-wider text-mute">{sub.speedBadge}</span>
        <h3 class="font-sans font-bold text-xl text-ink">{sub.speedTitle}</h3>
        <p class="text-sm text-body leading-relaxed max-w-lg">
          {sub.speedDesc}
        </p>
      </div>

      <div class="flex flex-col gap-2 shrink-0 w-full md:w-auto font-mono text-[10px] border border-hairline rounded-xl p-4 bg-canvas-soft-2/50 backdrop-blur-xs select-none">
        <div class="flex justify-between gap-6"><span class="text-mute">{sub.techLabels.framework}:</span> <span class="text-ink font-semibold">Astro v5</span></div>
        <div class="flex justify-between gap-6"><span class="text-mute">{sub.techLabels.css}:</span> <span class="text-ink font-semibold">Tailwind v4</span></div>
        <div class="flex justify-between gap-6"><span class="text-mute">{sub.techLabels.generation}:</span> <span class="text-ink font-semibold">Client Canvas</span></div>
        <div class="flex justify-between gap-6"><span class="text-mute">{sub.techLabels.build}:</span> <span class="text-ink font-semibold">Static HTML</span></div>
      </div>
    </div>

    <!-- CTA -->
    <div class="flex flex-col items-center gap-4 text-center mt-4">
      <h3 class="font-sans font-bold text-2xl text-ink">{sub.ctaTitle}</h3>
      <p class="text-sm text-body max-w-sm">{sub.ctaSubtitle}</p>
      <a href={localizePath('/')} class="mt-2 inline-flex items-center justify-center px-6 py-3 font-sans font-bold text-xs bg-gradient-to-r from-[#ff1b6b] to-[#eca0ff] text-white rounded-lg transition-transform hover:scale-[1.02] hover:opacity-95 shadow-lg shadow-[#ff1b6b]/20 hover:shadow-xl active:scale-95 cursor-pointer">
        {sub.ctaBtn}
      </a>
    </div>
  </main>

  <Footer />
</Layout>
