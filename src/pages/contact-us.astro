---
import Layout from '../layouts/Layout.astro';
import Header from '../components/mainpage/Header.astro';
import Footer from '../components/mainpage/Footer.astro';
import { translations } from '../i18n/translations';
import { getSubpageData } from '../i18n/subpageData';

const locale = Astro.currentLocale || 'en';
const t = translations[locale] || translations.en;
const sub = getSubpageData(locale).contact;

function localizePath(path: string): string {
  return locale === 'en' ? path : `/${locale}${path}`;
}
---

<Layout title={`${sub.title} | ${t.title}`} description={sub.metaDesc}>
  <!-- Background Grid & Premium Blur Glows Overlay -->
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
    <div class="absolute inset-0 grid-pattern opacity-60 dark:opacity-30"></div>
    <div class="absolute -top-40 -right-40 w-[600px] h-[600px] rounded-full bg-gradient-to-br from-[#ff1b6b]/15 to-[#eca0ff]/15 blur-[120px] dark:from-[#ff1b6b]/10 dark:to-[#eca0ff]/10"></div>
    <div class="absolute bottom-20 -left-60 w-[500px] h-[500px] rounded-full bg-gradient-to-tr from-indigo-500/10 to-emerald-500/10 blur-[100px] dark:from-indigo-900/5 dark:to-emerald-950/5"></div>
  </div>

  <Header />

  <main class="relative z-10 flex-1 max-w-5xl mx-auto px-4 py-16 w-full flex flex-col gap-12">
    <!-- Header -->
    <div class="flex flex-col items-center text-center gap-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 text-[10px] font-mono font-semibold uppercase tracking-wider text-[#ff1b6b] bg-[#ff1b6b]/10 border border-[#ff1b6b]/20 rounded-full">
        {sub.badge}
      </span>
      <h1 class="text-3xl md:text-4xl font-sans font-bold tracking-tight text-ink mt-2">
        {sub.heading}
      </h1>
      <p class="text-sm text-body max-w-md mt-1 leading-relaxed">
        {sub.subheading}
      </p>
    </div>

    <!-- Main Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start mt-4">
      <!-- Left Column: Info -->
      <div class="col-span-1 md:col-span-5 flex flex-col gap-6">
        <div class="bg-canvas border border-hairline rounded-2xl p-6 flex flex-col gap-6 shadow-xs relative overflow-hidden">
          <div class="absolute -right-16 -top-16 w-40 h-40 rounded-full bg-gradient-to-br from-indigo-500/10 to-blue-500/10 blur-xl pointer-events-none"></div>
          
          <h2 class="font-sans font-bold text-lg text-ink">{sub.infoTitle}</h2>
          <p class="text-xs text-body leading-relaxed">
            {sub.infoDesc}
          </p>

          <hr class="border-hairline" />

          <div class="flex flex-col gap-4">
            <!-- Email -->
            <div class="flex items-start gap-3.5">
              <div class="w-8 h-8 rounded-lg bg-[#ff1b6b]/10 text-[#ff1b6b] flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
              </div>
              <div class="flex flex-col gap-0.5">
                <span class="text-[10px] font-mono text-mute uppercase">{sub.channels.email}</span>
                <a href="mailto:support@onlineqrgenerators.com" class="text-xs font-semibold text-ink hover:text-[#ff1b6b] transition-colors">support@onlineqrgenerators.com</a>
              </div>
            </div>

            <!-- GitHub -->
            <div class="flex items-start gap-3.5">
              <div class="w-8 h-8 rounded-lg bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.11.82-.26.82-.577v-2.234c-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.43.372.82 1.102.82 2.222v3.293c0 .319.22.694.825.576C20.565 21.795 24 17.3 24 12c0-6.63-5.37-12-12-12z"/>
                </svg>
              </div>
              <div class="flex flex-col gap-0.5">
                <span class="text-[10px] font-mono text-mute uppercase">{sub.channels.github}</span>
                <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-ink hover:text-purple-600 transition-colors">GitHub Repository</a>
              </div>
            </div>

            <!-- Discord -->
            <div class="flex items-start gap-3.5">
              <div class="w-8 h-8 rounded-lg bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028 14.09 14.09 0 001.226-1.994.076.076 0 00-.041-.106 13.107 13.107 0 01-1.873-.894.077.077 0 01-.008-.128c.126-.093.252-.19.372-.287a.075.075 0 01.077-.011 19.82 19.82 0 0010.162 0 .078.078 0 01.078.01c.12.098.246.195.373.289a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.894.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.156-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.156 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.156-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.156 2.418z"/>
                </svg>
              </div>
              <div class="flex flex-col gap-0.5">
                <span class="text-[10px] font-mono text-mute uppercase">{sub.channels.discord}</span>
                <a href="https://discord.com" target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-ink hover:text-blue-600 transition-colors">Discord Server</a>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-gradient-to-br from-[#ff1b6b]/5 to-[#eca0ff]/5 border border-hairline rounded-2xl p-6 shadow-sm flex flex-col gap-3">
          <div class="flex items-center justify-between">
            <span class="text-[9px] font-mono uppercase tracking-wider text-[#ff1b6b] font-semibold">{sub.responseBadge}</span>
            <span class="text-[9px] font-mono px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">{sub.responseTime}</span>
          </div>
          <h3 class="font-sans font-bold text-sm text-ink">{sub.responseTitle}</h3>
          <p class="text-xs text-body leading-relaxed">
            {sub.responseDesc}
          </p>
          <a href={localizePath('/#faq')} class="text-[11px] font-semibold text-[#ff1b6b] hover:underline flex items-center gap-1 mt-1">
            {sub.faqPrompt}
          </a>
        </div>
      </div>

      <!-- Right Column: Interactive Form -->
      <div class="col-span-1 md:col-span-7">
        <div class="bg-canvas border border-hairline rounded-2xl p-6 md:p-8 shadow-md relative overflow-hidden transition-all duration-300 min-h-[460px] flex flex-col justify-center">
          <div class="absolute -right-24 -bottom-24 w-48 h-48 rounded-full bg-gradient-to-tr from-[#ff1b6b]/10 to-[#eca0ff]/10 blur-xl pointer-events-none"></div>
          
          <!-- Contact Form Container -->
          <div id="contact-form-wrapper">
            <h2 class="font-sans font-bold text-xl text-ink mb-1">{sub.formTitle}</h2>
            <p class="text-xs text-mute mb-6">{sub.formSubtitle}</p>

            <form id="contact-form" class="flex flex-col gap-4">
              <!-- Name & Email Row -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="flex flex-col gap-1.5">
                  <label for="name" class="text-[11px] font-mono uppercase tracking-wider text-mute">{sub.nameLabel}</label>
                  <input type="text" id="name" required placeholder={sub.namePlaceholder} class="px-3.5 py-2.5 text-xs w-full bg-canvas-soft border border-hairline rounded-lg" />
                </div>
                <div class="flex flex-col gap-1.5">
                  <label for="email" class="text-[11px] font-mono uppercase tracking-wider text-mute">{sub.emailLabel}</label>
                  <input type="email" id="email" required placeholder={sub.emailPlaceholder} class="px-3.5 py-2.5 text-xs w-full bg-canvas-soft border border-hairline rounded-lg" />
                </div>
              </div>

              <!-- Subject -->
              <div class="flex flex-col gap-1.5">
                <label for="subject" class="text-[11px] font-mono uppercase tracking-wider text-mute">{sub.subjectLabel}</label>
                <input type="text" id="subject" required placeholder={sub.subjectPlaceholder} class="px-3.5 py-2.5 text-xs w-full bg-canvas-soft border border-hairline rounded-lg" />
              </div>

              <!-- Message -->
              <div class="flex flex-col gap-1.5">
                <label for="message" class="text-[11px] font-mono uppercase tracking-wider text-mute">{sub.messageLabel}</label>
                <textarea id="message" required rows="5" placeholder={sub.messagePlaceholder} class="px-3.5 py-2.5 text-xs w-full bg-canvas-soft border border-hairline rounded-lg resize-none"></textarea>
              </div>

              <!-- Submit Button -->
              <button type="submit" class="mt-2 w-full bg-gradient-to-r from-[#ff1b6b] to-[#eca0ff] text-white font-bold text-xs py-3 rounded-lg hover:opacity-95 transition-all duration-200 hover:scale-[1.01] hover:shadow-lg hover:shadow-[#ff1b6b]/10 active:scale-95 cursor-pointer border-0">
                {sub.submitBtn}
              </button>
            </form>
          </div>

          <!-- Success Message State (Hidden Initially) -->
          <div id="contact-success-state" class="hidden flex-col items-center text-center gap-4 py-8 animate-fade-in">
            <div class="w-14 h-14 rounded-full bg-success/10 text-success flex items-center justify-center animate-bounce">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
            </div>
            <h3 class="font-sans font-bold text-xl text-ink">{sub.success.title}</h3>
            <p class="text-xs text-body leading-relaxed max-w-sm">
              {sub.success.desc}
            </p>
            <div class="flex items-center gap-3 mt-4">
              <button id="btn-reset-form" class="px-5 py-2 border border-hairline rounded-lg text-xs hover:bg-canvas-soft-2 font-medium transition-all cursor-pointer">
                {sub.success.resetBtn}
              </button>
              <a href="mailto:support@onlineqrgenerators.com" class="px-5 py-2 bg-canvas-soft border border-hairline rounded-lg text-xs text-ink hover:text-[#ff1b6b] font-medium transition-all">
                Direct Email
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <script>
    // Handle form submit state client side
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('contact-form');
      const formWrapper = document.getElementById('contact-form-wrapper');
      const successState = document.getElementById('contact-success-state');
      const resetBtn = document.getElementById('btn-reset-form');

      if (form && formWrapper && successState) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          formWrapper.classList.add('hidden');
          successState.classList.remove('hidden');
          successState.classList.add('flex');
        });

        resetBtn?.addEventListener('click', () => {
          if (form instanceof HTMLFormElement) {
            form.reset();
          }
          successState.classList.add('hidden');
          successState.classList.remove('flex');
          formWrapper.classList.remove('hidden');
        });
      }
    });
  </script>
</Layout>
