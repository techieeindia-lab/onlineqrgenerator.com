<script>
  // Mobile drawer controls
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileDrawer = document.getElementById('mobile-nav-drawer');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (mobileBtn && mobileDrawer) {
    const toggleMenu = () => {
      const isExpanded = mobileBtn.getAttribute('aria-expanded') === 'true';
      const nextState = !isExpanded;
      mobileBtn.setAttribute('aria-expanded', String(nextState));
      mobileDrawer.classList.toggle('hidden', !nextState);
      hamburgerIcon?.classList.toggle('hidden', nextState);
      closeIcon?.classList.toggle('hidden', !nextState);
      document.body.classList.toggle('overflow-hidden', nextState);
    };

    mobileBtn.addEventListener('click', toggleMenu);

    mobileDrawer.querySelectorAll('.mobile-nav-link').forEach(link => {
      link.addEventListener('click', () => {
        mobileBtn.setAttribute('aria-expanded', 'false');
        mobileDrawer.classList.add('hidden');
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
      });
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mobileDrawer.classList.contains('hidden')) {
        mobileBtn.setAttribute('aria-expanded', 'false');
        mobileDrawer.classList.add('hidden');
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
      }
    });
  }

  // Desktop mega-menus touch/click accessibility
  function setupDesktopDropdown(buttonId: string, dropdownId: string) {
    const btn = document.getElementById(buttonId);
    const dropdown = document.getElementById(dropdownId);
    if (!btn || !dropdown) return;

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      const nextState = !isExpanded;
      btn.setAttribute('aria-expanded', String(nextState));
      
      if (nextState) {
        dropdown.classList.add('!opacity-100', '!visible', '!translate-y-0', '!pointer-events-auto');
      } else {
        dropdown.classList.remove('!opacity-100', '!visible', '!translate-y-0', '!pointer-events-auto');
      }
    });
  }

  setupDesktopDropdown('types-menu-btn', 'types-dropdown');
  setupDesktopDropdown('industries-menu-btn', 'industries-dropdown');

  // Close dropdowns on outside click or escape
  window.addEventListener('click', () => {
    ['types', 'industries'].forEach(name => {
      const btn = document.getElementById(`${name}-menu-btn`);
      const dropdown = document.getElementById(`${name}-dropdown`);
      if (btn && dropdown) {
        btn.setAttribute('aria-expanded', 'false');
        dropdown.classList.remove('!opacity-100', '!visible', '!translate-y-0', '!pointer-events-auto');
      }
    });
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      ['types', 'industries'].forEach(name => {
        const btn = document.getElementById(`${name}-menu-btn`);
        const dropdown = document.getElementById(`${name}-dropdown`);
        if (btn && dropdown) {
          btn.setAttribute('aria-expanded', 'false');
          dropdown.classList.remove('!opacity-100', '!visible', '!translate-y-0', '!pointer-events-auto');
        }
      });
    }
  });
</script>
