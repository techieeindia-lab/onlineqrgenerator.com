---
import { translations } from '../../i18n/translations';
import Logo from '../Logo.astro';

interface Props {
  landingPageData?: {
    slug: string;
    title: string;
    headline: string;
    description: string;
    defaultType: string;
    ctaText: string;
    details: string;
    features: string[];
    [key: string]: any;
  };
}

const { landingPageData } = Astro.props;

const locale = Astro.currentLocale || 'en';
const t = translations[locale] || translations.en;

// Generate list of other locales for language switcher
const localesList = [
  { code: 'en', label: '🇬🇧 English' },
  { code: 'es', label: '🇪🇸 Español' },
  { code: 'fr', label: '🇫🇷 Français' },
  { code: 'de', label: '🇩🇪 Deutsch' },
  { code: 'it', label: '🇮🇹 Italiano' },
  { code: 'pt', label: '🇵🇹 Português' },
  { code: 'ru', label: '🇷🇺 Русский' },
  { code: 'ja', label: '🇯🇵 日本語' },
  { code: 'ko', label: '🇰🇷 한국어' },
  { code: 'ar', label: '🇸🇦 العربية' },
  { code: 'id', label: '🇮🇩 Bahasa Indonesia' },
];

const currentLanguageLabel = localesList.find(l => l.code === locale)?.label || 'English';

// Helper to prefix paths based on locale
function localizePath(path: string): string {
  return locale === 'en' ? path : `/${locale}${path}`;
}

const pathname = Astro.url.pathname;
const locales = ['en', 'es', 'fr', 'de', 'pt', 'ar', 'ru', 'it', 'ja', 'ko', 'id'];
const currentPrefix = locales.find(l => l !== 'en' && (pathname.startsWith(`/${l}/`) || pathname === `/${l}`));
const cleanPath = currentPrefix ? (pathname.substring(currentPrefix.length + 1) || '/') : pathname;
const normalizedCleanPath = cleanPath.startsWith('/') ? cleanPath : '/' + cleanPath;

const qrTypesList = [
  { slug: 'url', label: t.types.url, path: '/types/url', desc: t.typeDescriptions.url, icon: 'url', bgClass: 'bg-blue-500/10 text-blue-600 dark:text-blue-400' },
  { slug: 'wifi', label: t.types.wifi, path: '/types/wifi', desc: t.typeDescriptions.wifi, icon: 'wifi', bgClass: 'bg-green-500/10 text-green-600 dark:text-green-400' },
  { slug: 'vcard', label: t.types.contact, path: '/types/vcard', desc: t.typeDescriptions.contact, icon: 'vcard', bgClass: 'bg-indigo-500/10 text-indigo-600 dark:text-indigo-400' },
  { slug: 'whatsapp', label: t.types.whatsapp, path: '/types/whatsapp', desc: t.typeDescriptions.whatsapp, icon: 'whatsapp', bgClass: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400' },
  { slug: 'text', label: t.types.text, path: '/types/text', desc: t.typeDescriptions.text, icon: 'text', bgClass: 'bg-teal-500/10 text-teal-600 dark:text-teal-400' },
  { slug: 'crypto', label: t.types.crypto, path: '/types/crypto', desc: t.typeDescriptions.crypto, icon: 'crypto', bgClass: 'bg-amber-500/10 text-amber-600 dark:text-amber-400' },
  { slug: 'email', label: t.types.email, path: '/types/email', desc: t.typeDescriptions.email, icon: 'email', bgClass: 'bg-rose-500/10 text-rose-600 dark:text-rose-400' },
  { slug: 'sms', label: t.types.phone, path: '/types/sms', desc: t.typeDescriptions.phone, icon: 'phone', bgClass: 'bg-cyan-500/10 text-cyan-600 dark:text-cyan-400' },
  { slug: 'social', label: t.types.social, path: '/types/social', desc: t.typeDescriptions.social, icon: 'social', bgClass: 'bg-violet-500/10 text-violet-600 dark:text-violet-400' },
  { slug: 'feedback', label: t.types.feedback, path: '/types/feedback', desc: t.typeDescriptions.feedback, icon: 'feedback', bgClass: 'bg-orange-500/10 text-orange-600 dark:text-orange-400' },
];

const industriesDropdownList = [
  { slug: 'restaurants', label: t.industries.restaurants, path: '/industries/restaurants', desc: t.industryDescriptions.restaurants, icon: 'restaurants', bgClass: 'bg-amber-500/10 text-amber-600 dark:text-amber-400' },
  { slug: 'real-estate', label: t.industries.realEstate, path: '/industries/real-estate', desc: t.industryDescriptions.realEstate, icon: 'real-estate', bgClass: 'bg-blue-500/10 text-blue-600 dark:text-blue-400' },
  { slug: 'education', label: t.industries.education, path: '/industries/education', desc: t.industryDescriptions.education, icon: 'education', bgClass: 'bg-purple-500/10 text-purple-600 dark:text-purple-400' },
  { slug: 'events', label: t.industries.events, path: '/industries/events', desc: t.industryDescriptions.events, icon: 'events', bgClass: 'bg-rose-500/10 text-rose-600 dark:text-rose-400' },
  { slug: 'retail', label: t.industries.retail, path: '/industries/retail', desc: t.industryDescriptions.retail, icon: 'retail', bgClass: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400' },
  { slug: 'marketing', label: t.industries.marketing, path: '/industries/marketing', desc: t.industryDescriptions.marketing, icon: 'marketing', bgClass: 'bg-indigo-500/10 text-indigo-600 dark:text-indigo-400' },
];
---
<header class="sticky top-0 z-40 border-b border-hairline bg-canvas backdrop-blur-md transition-all duration-200 shadow-xs">
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between gap-4">
    <!-- Brand Logo & Title -->
    <a href={locale === 'en' ? '/' : `/${locale}/`} class="flex items-center gap-2.5 font-sans font-bold text-base sm:text-lg tracking-tight hover:opacity-90 transition-opacity shrink-0 whitespace-nowrap">
      <Logo class="w-7 h-7 shrink-0" />
      <span class="text-ink">OnlineQR <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#ff1b6b] to-[#eca0ff]">Generators</span></span>
    </a>
    
    <!-- Desktop Navigation (visible on lg: screens >= 1024px) -->
    <nav class="hidden lg:flex items-center gap-3.5 xl:gap-5 text-xs xl:text-sm font-medium text-slate-600 dark:text-slate-300">
      <a href={localizePath('/#generator')} class="hover:text-slate-950 dark:hover:text-white transition-colors relative group py-2 whitespace-nowrap">
        {t.nav.generator}
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-gradient-to-r from-[#ff1b6b] to-[#eca0ff] transition-all duration-300 group-hover:w-full"></span>
      </a>
      <a href={localizePath('/#scanner')} class="hover:text-slate-950 dark:hover:text-white transition-colors relative group py-2 whitespace-nowrap">
        {t.nav.scanner}
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-gradient-to-r from-[#ff1b6b] to-[#eca0ff] transition-all duration-300 group-hover:w-full"></span>
      </a>
      <a href={localizePath('/#bulk')} class="hover:text-slate-950 dark:hover:text-white transition-colors relative group py-2 whitespace-nowrap">
        {t.nav.bulk}
        <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-gradient-to-r from-[#ff1b6b] to-[#eca0ff] transition-all duration-300 group-hover:w-full"></span>
      </a>
      
      <!-- QR Types Dropdown -->
      <div class="relative group/types py-2" id="types-menu-container">
        <button id="types-menu-btn" class="hover:text-slate-950 dark:hover:text-white transition-colors flex items-center gap-1 cursor-pointer relative pb-1 font-medium whitespace-nowrap" aria-haspopup="true" aria-expanded="false">
          <span>{t.nav.types}</span>
          <svg class="w-3.5 h-3.5 text-mute transition-transform duration-200 group-hover/types:rotate-180 group-focus-within/types:rotate-180 dropdown-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-gradient-to-r from-[#ff1b6b] to-[#eca0ff] transition-all duration-300 group-hover/types:w-full"></span>
        </button>
        <!-- Hover & focus-within bridge container -->
        <div id="types-dropdown" class="absolute left-1/2 -translate-x-1/2 top-full pt-2 opacity-0 invisible translate-y-2 pointer-events-none group-hover/types:opacity-100 group-hover/types:visible group-hover/types:translate-y-0 group-hover/types:pointer-events-auto group-focus-within/types:opacity-100 group-focus-within/types:visible group-focus-within/types:translate-y-0 group-focus-within/types:pointer-events-auto transition-all duration-200 ease-out z-50">
          <div class="w-[580px] xl:w-[640px] max-w-[90vw] rounded-2xl border border-slate-200/80 dark:border-white/10 bg-white/98 dark:bg-[#101018]/98 backdrop-blur-2xl shadow-2xl shadow-slate-900/10 dark:shadow-black/70 p-3.5 grid grid-cols-3 gap-2">
            {qrTypesList.map((item) => (
              <a 
                href={localizePath(item.path)} 
                class="group/item flex items-start gap-2.5 p-2.5 rounded-xl hover:bg-slate-100/80 dark:hover:bg-white/[0.06] border border-transparent hover:border-slate-200/60 dark:hover:border-white/10 transition-all duration-150"
              >
                <div class={`w-9 h-9 rounded-lg flex items-center justify-center shrink-0 ${item.bgClass} group-hover/item:scale-108 transition-transform duration-150 shadow-xs`}>
                  {item.icon === 'url' && (
                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
                    </svg>
                  )}
                  {item.icon === 'wifi' && (
                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8.284 16.284A3 3 0 0012 17a3 3 0 003.716-.716M5.11 13.11a7 7 0 019.78 0M1.937 9.937a11 11 0 0116.126 0M12 21a1 1 0 100-2 1 1 0 000 2z" />
                    </svg>
                  )}
                  {item.icon === 'vcard' && (
                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 9h3.75M15 12h3.75M15 15h3.75M4.5 19.5h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15A2.25 2.25 0 002.25 6.75v10.5a2.25 2.25 0 002.25 2.25zm3-10.5a2.25 2.25 0 114.5 0 2.25 2.25 0 01-4.5 0zM6.75 15.75h6.75" />
                    </svg>
                  )}
                  {item.icon === 'whatsapp' && (
                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 10-9-9c0 1.5.37 2.91 1.02 4.15L3 21l4.98-1.02A8.96 8.96 0 0012 21z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8.5 9.5c.3-.6.6-.6 1-.6h.5c.2 0 .4.1.5.4l.7 1.7c.1.3.1.5-.1.7l-.5.6c.4.8 1.1 1.5 1.9 1.9l.6-.5c.2-.2.4-.2.7-.1l1.7.7c.3.1.4.3.4.5v.5c0 .4 0 .7-.6 1-1.3.6-3.8-.4-5.5-2.1-1.7-1.7-2.7-4.2-2.1-5.5z" />
                    </svg>
                  )}
                  {item.icon === 'text' && (
                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                    </svg>
                  )}
                  {item.icon === 'crypto' && (
                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 9.75h4.5m-4.5 2.25h4.5m-4.5 2.25h4.5M12 7.5v9" />
                    </svg>
                  )}
                  {item.icon === 'email' && (
                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                    </svg>
                  )}
                  {item.icon === 'phone' && (
                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-1.514 2.019a14.992 14.992 0 01-6.384-6.384l2.019-1.514c.362-.272.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                    </svg>
                  )}
                  {item.icon === 'social' && (
                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
                    </svg>
                  )}
                  {item.icon === 'feedback' && (
                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499c.151-.377.724-.377.876 0l1.98 4.957 5.378.435c.414.033.58.54.262.836l-4.017 3.738 1.185 5.263c.092.408-.344.726-.697.51l-4.693-2.853-4.693 2.853c-.353.216-.789-.102-.697-.51l1.185-5.263-4.017-3.738c-.318-.296-.152-.803.262-.836l5.378-.435 1.98-4.957z" />
                    </svg>
                  )}
                </div>
                <div class="flex flex-col gap-0.5 min-w-0">
                  <span class="text-xs font-semibold text-slate-800 dark:text-slate-100 group-hover/item:text-[#ff1b6b] dark:group-hover/item:text-[#eca0ff] transition-colors truncate">{item.label}</span>
                  <span class="text-[11px] leading-snug text-slate-500 dark:text-slate-400 line-clamp-2">{item.desc}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Industries Dropdown -->
      <div class="relative group/industries py-2" id="industries-menu-container">
        <button id="industries-menu-btn" class="hover:text-slate-950 dark:hover:text-white transition-colors flex items-center gap-1 cursor-pointer relative pb-1 font-medium whitespace-nowrap" aria-haspopup="true" aria-expanded="false">
          <span>{t.nav.industries}</span>
          <svg class="w-3.5 h-3.5 text-mute transition-transform duration-200 group-hover/industries:rotate-180 group-focus-within/industries:rotate-180 dropdown-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-gradient-to-r from-[#ff1b6b] to-[#eca0ff] transition-all duration-300 group-hover/industries:w-full"></span>
        </button>
        <!-- Hover & focus-within bridge container -->
        <div id="industries-dropdown" class="absolute left-1/2 -translate-x-1/2 top-full pt-2 opacity-0 invisible translate-y-2 pointer-events-none group-hover/industries:opacity-100 group-hover/industries:visible group-hover/industries:translate-y-0 group-hover/industries:pointer-events-auto group-focus-within/industries:opacity-100 group-focus-within/industries:visible group-focus-within/industries:translate-y-0 group-focus-within/industries:pointer-events-auto transition-all duration-200 ease-out z-50">
          <div class="w-[480px] xl:w-[520px] max-w-[90vw] rounded-2xl border border-slate-200/80 dark:border-white/10 bg-white/98 dark:bg-[#101018]/98 backdrop-blur-2xl shadow-2xl shadow-slate-900/10 dark:shadow-black/70 p-3.5 grid grid-cols-2 gap-2">
            {industriesDropdownList.map((item) => (
              <a 
                href={localizePath(item.path)} 
                class="group/item flex items-start gap-2.5 p-2.5 rounded-xl hover:bg-slate-100/80 dark:hover:bg-white/[0.06] border border-transparent hover:border-slate-200/60 dark:hover:border-white/10 transition-all duration-150"
              >
                <div class={`w-9 h-9 rounded-lg flex items-center justify-center shrink-0 ${item.bgClass} group-hover/item:scale-108 transition-transform duration-150 shadow-xs`}>
                  {item.icon === 'restaurants' && (
                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.75 9a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 16.5l-.75-9m16.5 0H3.75m16.5 0a2.25 2.25 0 00-2.25-2.25H6A2.25 2.25 0 003.75 7.5m16.5 0V6a2.25 2.25 0 00-2.25-2.25h-1.5A2.25 2.25 0 0014.25 6v1.5M9 10.5v3.75a1.5 1.5 0 003 0V10.5m3 0v3.75a1.5 1.5 0 003 0V10.5" />
                    </svg>
                  )}
                  {item.icon === 'real-estate' && (
                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                    </svg>
                  )}
                  {item.icon === 'education' && (
                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.62 48.62 0 0112 20.904a48.62 48.62 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M22.25 9.375a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
                    </svg>
                  )}
                  {item.icon === 'events' && (
                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-12v.75m0 3v.75m0 3v.75m0 3V18m-3-12h15c.621 0 1.125.504 1.125 1.125v10.5c0 .621-.504 1.125-1.125 1.125h-15a1.125 1.125 0 01-1.125-1.125V7.125C3.375 6.504 3.879 6 4.5 6zM5.25 9h13.5M5.25 13.5h13.5" />
                    </svg>
                  )}
                  {item.icon === 'retail' && (
                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                    </svg>
                  )}
                  {item.icon === 'marketing' && (
                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
