                      <span>Circle</span>
                    </button>
                    <button type="button" class="logo-frame-btn p-2 border border-hairline hover:bg-canvas-soft rounded-sm text-[10px] transition-colors flex flex-col items-center justify-center gap-1 cursor-pointer" data-frame="square">
                      <div class="w-5 h-5 bg-white border border-neutral-300 rounded-md shadow-sm"></div>
                      <span>Square</span>
                    </button>
                    <button type="button" class="logo-frame-btn p-2 border border-hairline hover:bg-canvas-soft rounded-sm text-[10px] transition-colors flex flex-col items-center justify-center gap-1 cursor-pointer" data-frame="glass">
                      <div class="w-5 h-5 bg-white/40 border border-white/60 rounded-md shadow-sm backdrop-blur-xs"></div>
                      <span>Glass</span>
                    </button>
                  </div>

                  <div class="grid grid-cols-2 gap-3 mt-1">
                    <div class="flex flex-col gap-1">
                      <span class="text-[10px] text-body">{ui.generator.frameBg}</span>
                      <div class="flex gap-2 items-center">
                        <input type="color" id="logo-frame-color" class="w-6 h-6 rounded-sm cursor-pointer p-0 border-0 bg-transparent" value="#ffffff" />
                        <span class="text-[9px] text-mute uppercase font-mono" id="logo-frame-color-hex">#FFFFFF</span>
                      </div>
                    </div>
                    <div class="flex flex-col gap-1">
                      <span class="text-[10px] text-body">{ui.generator.logoScale}</span>
                      <select id="logo-size-select" class="h-7 px-2 text-[10px] rounded-sm bg-canvas border border-hairline">
                        <option value="0.25">{ui.generator.scaleSmall}</option>
                        <option value="0.33" selected>{ui.generator.scaleMedium}</option>
                        <option value="0.4">{ui.generator.scaleLarge}</option>
                      </select>
                    </div>
                  </div>

                  <label class="flex items-center gap-2 mt-1 cursor-pointer select-none">
                    <input type="checkbox" id="logo-shadow-toggle" class="rounded-sm border-hairline text-ink focus:ring-ink" checked />
                    <span class="text-[10px] text-body">{ui.generator.softShadow}</span>
                  </label>
                </div>

                <button id="clear-logo" class="w-full h-9 border border-hairline text-xs font-semibold hover:bg-canvas-soft text-error rounded-sm flex items-center justify-center gap-1 transition-all cursor-pointer">
                  <span>{t.customization.logoNone}</span>
                </button>
              </div>
            </div>

            <!-- 4. Advanced Settings -->
            <div class="accordion-item">
              <button class="accordion-header w-full px-5 py-4 text-left font-sans font-semibold text-sm flex items-center justify-between text-ink hover:bg-canvas-soft transition-all">
                <span>{t.customization.advanced}</span>
                <svg class="w-4 h-4 text-mute transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </button>
              <div class="accordion-content px-5 pb-5 pt-1 flex flex-col gap-4 hidden">
                <div class="flex flex-col gap-1.5">
                  <span class="text-xs text-body flex items-center gap-1.5">
                    <span>{t.customization.errorCorrection}</span>
                    <span class="tooltip-trigger group relative cursor-help text-mute font-mono text-[9px] bg-canvas-soft-2 border border-hairline w-4 h-4 rounded-full flex items-center justify-center hover:bg-canvas-soft hover:text-ink transition-all select-none">?
                      <span class="pointer-events-none absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-48 p-2.5 rounded-xl bg-[#09090f] text-white/95 text-[10px] font-sans font-medium leading-normal opacity-0 group-hover:opacity-100 transition-opacity shadow-xl z-50 text-center border border-hairline-strong/20">Higher levels (e.g. H) restore readability if the QR code gets scratched or partially covered.</span>
                    </span>
                  </span>
                  <select id="ecc-level" class="h-9 px-3 text-xs rounded-sm">
                    <option value="L">{ui.generator.eccLow}</option>
                    <option value="M">{ui.generator.eccMedium}</option>
                    <option value="Q">{ui.generator.eccQuartile}</option>
                    <option value="H" selected>{ui.generator.eccHigh}</option>
                  </select>
                  <span class="text-[10px] text-mute">{t.customization.errorCorrectionDesc}</span>
                </div>
                <div class="flex flex-col gap-1.5">
                  <div class="flex justify-between text-xs text-body">
                    <span>{t.customization.size}</span>
                    <span id="size-val">350px</span>
                  </div>
                  <input type="range" id="size-range" min="200" max="1000" step="50" value="350" class="w-full h-1 bg-hairline rounded-lg appearance-none cursor-pointer accent-ink" />
                </div>
              </div>
            </div>
          </div>
      </div>
    </div>
