---
import { translations } from '../../i18n/translations';
import Logo from '../Logo.astro';

const locale = Astro.currentLocale || 'en';
const t = translations[locale] || translations.en;

function localizePath(path: string): string {
  return locale === 'en' ? path : `/${locale}${path}`;
}

const footerLabels: Record<string, { product: string; company: string; resources: string; legal: string; stayUpdated: string; join: string; rights: string; placeholder: string }> = {
  en: { product: 'Product', company: 'Company', resources: 'Resources', legal: 'Legal', stayUpdated: 'Stay Updated', join: 'Join', rights: 'All rights reserved.', placeholder: 'Enter your email...' },
  es: { product: 'Producto', company: 'Empresa', resources: 'Recursos', legal: 'Legal', stayUpdated: 'Mantente al día', join: 'Unirse', rights: 'Todos los derechos reservados.', placeholder: 'Ingrese su correo...' },
  fr: { product: 'Produit', company: 'Entreprise', resources: 'Ressources', legal: 'Légal', stayUpdated: 'Restez informé', join: 'Rejoindre', rights: 'Tous droits réservés.', placeholder: 'Entrez votre email...' },
  de: { product: 'Produkt', company: 'Unternehmen', resources: 'Ressourcen', legal: 'Rechtliches', stayUpdated: 'Auf dem Laufenden bleiben', join: 'Beitreten', rights: 'Alle Rechte vorbehalten.', placeholder: 'E-Mail eingeben...' },
  it: { product: 'Prodotto', company: 'Azienda', resources: 'Risorse', legal: 'Legale', stayUpdated: 'Rimani aggiornato', join: 'Iscriviti', rights: 'Tutti i diritti riservati.', placeholder: 'Inserisci la tua email...' },
  pt: { product: 'Produto', company: 'Empresa', resources: 'Recursos', legal: 'Legal', stayUpdated: 'Fique Atualizado', join: 'Participar', rights: 'Todos os direitos reservados.', placeholder: 'Digite o seu e-mail...' },
  ru: { product: 'Продукт', company: 'Компания', resources: 'Ресурсы', legal: 'Юридическая информация', stayUpdated: 'Будьте в курсе', join: 'Подписаться', rights: 'Все права защищены.', placeholder: 'Введите ваш e-mail...' },
  ja: { product: 'プロダクト', company: '会社情報', resources: 'リソース', legal: '規約・方針', stayUpdated: '最新情報を受け取る', join: '登録', rights: 'All rights reserved.', placeholder: 'メールアドレスを入力...' },
  ko: { product: '서비스', company: '회사 정보', resources: '리소스', legal: '법적 고지', stayUpdated: '최신 소식 받기', join: '구독', rights: 'All rights reserved.', placeholder: '이메일 주소 입력...' },
  ar: { product: 'المنتج', company: 'الشركة', resources: 'الموارد', legal: 'قانوني', stayUpdated: 'ابق على اطلاع', join: 'انضمام', rights: 'جميع الحقوق محفوظة.', placeholder: 'أدخل بريدك الإلكتروني...' },
};

const labels = footerLabels[locale] || footerLabels.en;
---
<footer class="border-t border-hairline bg-canvas-soft-2/50 backdrop-blur-md py-12 relative z-10 transition-colors duration-200">
  <div class="max-w-6xl mx-auto px-4 grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-6 gap-8">
    <!-- Brand & Newsletter: Column 1 & 2 -->
    <div class="col-span-2 sm:col-span-4 md:col-span-2 lg:col-span-2 flex flex-col gap-3.5">
      <div class="flex items-center gap-2">
        <Logo class="w-6 h-6 shrink-0" />
        <span class="font-sans font-bold text-base tracking-tight text-ink">
          OnlineQR <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#ff1b6b] to-[#eca0ff]">Generators</span>
        </span>
      </div>
      <p class="text-xs text-body max-w-sm leading-relaxed">{t.subtitle}</p>
      
      <!-- Newsletter Form -->
      <form id="newsletter-form" class="flex flex-col gap-1.5 w-full max-w-xs mt-2" onsubmit="event.preventDefault(); window.dispatchEvent(new CustomEvent('app:toast', { detail: { message: 'Subscribed successfully!' } })); this.reset();">
        <span class="text-[10px] font-mono uppercase tracking-wider text-mute">{labels.stayUpdated}</span>
        <div class="flex bg-canvas border border-hairline rounded-lg p-1.5 shadow-sm hover:border-[#ff1b6b]/40 focus-within:border-[#ff1b6b] transition-all">
          <input type="email" required placeholder={labels.placeholder} class="bg-transparent border-0 outline-none text-[11px] text-ink px-2 py-1 w-full" />
          <button type="submit" class="bg-gradient-to-r from-[#ff1b6b] to-[#eca0ff] text-white font-bold text-[10px] px-3.5 py-1 rounded-md transition-all hover:opacity-95 hover:shadow-xs active:scale-95 cursor-pointer border-0">{labels.join}</button>
        </div>
      </form>

      <!-- Social Icons Row -->
      <div class="flex items-center gap-3.5 mt-1">
        <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="text-mute hover:text-[#ff1b6b] hover:scale-110 transition-all duration-200" title="GitHub">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.11.82-.26.82-.577v-2.234c-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.43.372.82 1.102.82 2.222v3.293c0 .319.22.694.825.576C20.565 21.795 24 17.3 24 12c0-6.63-5.37-12-12-12z"/></svg>
        </a>
        <a href="https://x.com" target="_blank" rel="noopener noreferrer" class="text-mute hover:text-[#ff1b6b] hover:scale-110 transition-all duration-200" title="X (Twitter)">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="https://discord.com" target="_blank" rel="noopener noreferrer" class="text-mute hover:text-[#ff1b6b] hover:scale-110 transition-all duration-200" title="Discord">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028 14.09 14.09 0 001.226-1.994.076.076 0 00-.041-.106 13.107 13.107 0 01-1.873-.894.077.077 0 01-.008-.128c.126-.093.252-.19.372-.287a.075.075 0 01.077-.011 19.82 19.82 0 0010.162 0 .078.078 0 01.078.01c.12.098.246.195.373.289a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.894.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.156-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.156 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.156-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.156 2.418z"/></svg>
        </a>
      </div>

      <span class="text-[10px] text-mute font-mono mt-4">© 2026 onlineqrgenerators.com. {labels.rights}</span>
    </div>
    
    <!-- Column 3: Product -->
    <div class="col-span-1 flex flex-col gap-2.5 text-xs">
      <span class="font-mono text-[10px] text-mute uppercase tracking-wider font-semibold">{labels.product}</span>
      <a href={localizePath('/#generator')} class="text-body hover:text-ink transition-colors">{t.nav.generator}</a>
      <a href={localizePath('/#scanner')} class="text-body hover:text-ink transition-colors">{t.nav.scanner}</a>
      <a href={localizePath('/#bulk')} class="text-body hover:text-ink transition-colors">{t.nav.bulk}</a>
      <a href={localizePath('/#history')} class="text-body hover:text-ink transition-colors">{t.nav.history}</a>
      <a href={localizePath('/#api')} class="text-body hover:text-ink transition-colors">{t.nav.api}</a>
    </div>

    <!-- Column 4: Company -->
    <div class="col-span-1 flex flex-col gap-2.5 text-xs">
      <span class="font-mono text-[10px] text-mute uppercase tracking-wider font-semibold">{labels.company}</span>
      <a href={localizePath('/about-us')} class="text-body hover:text-ink transition-colors">{t.nav.aboutUs}</a>
      <a href={localizePath('/contact-us')} class="text-body hover:text-ink transition-colors">{t.nav.contactUs}</a>
    </div>

    <!-- Column 5: Resources -->
    <div class="col-span-1 flex flex-col gap-2.5 text-xs">
      <span class="font-mono text-[10px] text-mute uppercase tracking-wider font-semibold">{labels.resources}</span>
      <a href={localizePath('/#faq')} class="text-body hover:text-ink transition-colors">{t.nav.faq}</a>
      <a href={localizePath('/types/url')} class="text-body hover:text-ink transition-colors">{t.nav.types}</a>
      <a href={localizePath('/industries/restaurants')} class="text-body hover:text-ink transition-colors">{t.nav.industries}</a>
      <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="text-body hover:text-ink transition-colors">GitHub Repo</a>
    </div>

    <!-- Column 6: Legal -->
    <div class="col-span-1 flex flex-col gap-2.5 text-xs">
      <span class="font-mono text-[10px] text-mute uppercase tracking-wider font-semibold">{labels.legal}</span>
      <a href={localizePath('/privacy-policy')} class="text-body hover:text-ink transition-colors">{t.nav.privacyPolicy}</a>
      <a href={localizePath('/terms-and-conditions')} class="text-body hover:text-ink transition-colors">{t.nav.terms}</a>
    </div>
  </div>
</footer>
