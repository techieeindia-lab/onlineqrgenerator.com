---
import { getSeoData } from '../../i18n/seoData';

const locale = Astro.currentLocale || 'en';
const isRtl = locale === 'ar';
const data = getSeoData(locale);
---

<section id="seo-guide" class="scroll-mt-24 border-t border-hairline pt-16 flex flex-col gap-12 max-w-4xl mx-auto w-full text-left" dir={isRtl ? 'rtl' : 'ltr'}>
  
  <!-- Header Title -->
  <div class="flex flex-col gap-4 text-center max-w-2xl mx-auto">
    <h2 class="text-3xl font-extrabold font-sans tracking-tight text-ink sm:text-4xl">
      {data.headerTitle}
    </h2>
    <p class="text-sm text-mute font-medium">
      {data.headerDesc}
    </p>
  </div>

  <!-- Intro Block -->
  <div class="glass-card rounded-2xl p-8 premium-shadow grid grid-cols-1 md:grid-cols-12 gap-8 items-center leading-relaxed relative overflow-hidden border-l-4 border-l-[#ff1b6b]">
    <div class="md:col-span-8 flex flex-col gap-4">
      <h3 class="text-xl font-bold font-sans text-ink">
        {data.introTitle}
      </h3>
      <p class="text-xs text-body">
        {data.introP1}
      </p>
      <p class="text-xs text-body">
        {data.introP2}
      </p>
    </div>
    <div class="md:col-span-4 flex items-center justify-center p-4 bg-[#ff1b6b]/5 border border-[#ff1b6b]/10 rounded-xl relative group select-none">
      <div class="absolute -right-4 -bottom-4 w-24 h-24 bg-gradient-to-tr from-[#ff1b6b] to-[#eca0ff] rounded-full blur-xl opacity-20 group-hover:scale-125 transition-transform duration-500"></div>
      <div class="relative w-28 h-28 bg-white dark:bg-zinc-900 border border-hairline rounded-lg flex items-center justify-center p-2.5 shadow-sm">
        <svg class="w-full h-full text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="6" height="6" rx="1" stroke-width="1.5" />
          <rect x="4" y="4" width="2" height="2" rx="0.5" fill="currentColor" stroke="none" />
          <rect x="16" y="2" width="6" height="6" rx="1" stroke-width="1.5" />
          <rect x="18" y="4" width="2" height="2" rx="0.5" fill="currentColor" stroke="none" />
          <rect x="2" y="16" width="6" height="6" rx="1" stroke-width="1.5" />
          <rect x="4" y="18" width="2" height="2" rx="0.5" fill="currentColor" stroke="none" />
          <rect x="10" y="2" width="2" height="2" rx="0.5" fill="currentColor" stroke="none" />
          <rect x="10" y="6" width="2" height="2" rx="0.5" fill="currentColor" stroke="none" />
          <rect x="14" y="4" width="2" height="2" rx="0.5" fill="currentColor" stroke="none" />
          <rect x="12" y="8" width="2" height="2" rx="0.5" fill="currentColor" stroke="none" />
          <rect x="10" y="10" width="2" height="2" rx="0.5" fill="currentColor" stroke="none" />
          <rect x="14" y="10" width="2" height="2" rx="0.5" fill="currentColor" stroke="none" />
          <rect x="10" y="14" width="2" height="2" rx="0.5" fill="currentColor" stroke="none" />
          <rect x="14" y="14" width="2" height="2" rx="0.5" fill="currentColor" stroke="none" />
          <rect x="18" y="10" width="2" height="2" rx="0.5" fill="currentColor" stroke="none" />
          <rect x="16" y="12" width="2" height="2" rx="0.5" fill="currentColor" stroke="none" />
          <rect x="10" y="18" width="2" height="2" rx="0.5" fill="currentColor" stroke="none" />
          <rect x="14" y="18" width="2" height="2" rx="0.5" fill="currentColor" stroke="none" />
          <rect x="18" y="16" width="2" height="2" rx="0.5" fill="currentColor" stroke="none" />
        </svg>
      </div>
    </div>
  </div>

  <!-- Core Formats Grid -->
  <div class="flex flex-col gap-6">
    <h3 class="text-xl font-bold font-sans text-ink text-center">
      {data.formatsTitle}
    </h3>
    <p class="text-xs text-center text-mute max-w-xl mx-auto -mt-3">
      {data.formatsDesc}
    </p>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {data.formatCards.map((card, idx) => (
        <div class="glass-card rounded-xl p-6 flex flex-col gap-3 premium-shadow premium-hover relative overflow-hidden group hover:border-[#ff1b6b]/30 transition-all duration-300">
          <div class="absolute top-0 inset-x-0 h-[3px] bg-gradient-to-r from-[#ff1b6b] to-[#eca0ff] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-[#ff1b6b]/10 to-[#eca0ff]/10 flex items-center justify-center shrink-0 border border-[#eca0ff]/15">
              {idx === 0 && (
                <svg class="w-4 h-4 text-[#ff1b6b]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
              )}
              {idx === 1 && (
                <svg class="w-4 h-4 text-[#ff1b6b]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
              )}
              {idx === 2 && (
                <svg class="w-4 h-4 text-[#ff1b6b]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              )}
              {idx === 3 && (
                <svg class="w-4 h-4 text-[#ff1b6b]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              )}
            </div>
            <h4 class="text-sm font-semibold font-sans text-ink">{card.title}</h4>
          </div>
          <p class="text-xs text-body leading-relaxed">
            {card.desc}
          </p>
        </div>
      ))}
    </div>
  </div>

  <!-- Branding with Custom Logos -->
  <div class="glass-card rounded-2xl p-8 premium-shadow flex flex-col md:flex-row gap-8 items-center leading-relaxed">
    <div class="flex flex-col gap-4 md:w-2/3">
      <h3 class="text-xl font-bold font-sans text-ink">
        {data.brandingTitle}
      </h3>
      <p class="text-xs text-body">
        {data.brandingP1}
      </p>
      <p class="text-xs text-body">
        {data.brandingP2}
      </p>
    </div>
    <div class="md:w-1/3 w-full flex flex-col gap-3 items-center justify-center p-5 bg-canvas-soft border border-hairline rounded-xl relative select-none">
      <span class="text-[9px] font-mono text-mute uppercase tracking-widest mb-1">{data.presetIconsTitle}</span>
      <div class="grid grid-cols-4 gap-2">
        <div class="w-10 h-10 rounded-full bg-white dark:bg-zinc-800 border border-hairline shadow-xs flex items-center justify-center hover:scale-110 transition-transform duration-200" title="Link">
          <svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
        </div>
        <div class="w-10 h-10 rounded-full bg-white dark:bg-zinc-800 border border-hairline shadow-xs flex items-center justify-center hover:scale-110 transition-transform duration-200" title="WiFi">
          <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071a10.5 10.5 0 0114.14 0M1.414 8.414a15 15 0 0121.172 0"></path></svg>
        </div>
        <div class="w-10 h-10 rounded-full bg-white dark:bg-zinc-800 border border-hairline shadow-xs flex items-center justify-center hover:scale-110 transition-transform duration-200" title="WhatsApp">
          <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.73-1.45L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436 0 9.86-4.37 9.864-9.799.002-2.63-1.023-5.101-2.885-6.968C16.588 2.01 14.113.987 11.5 .987c-5.445 0-9.87 4.373-9.874 9.8.001 2.006.528 3.96 1.528 5.698L2.182 21.8l5.59-1.464-.125-.182zm10.748-7.46c-.29-.145-1.716-.848-1.98-.942-.266-.096-.459-.145-.653.146-.192.29-.747.942-.916 1.135-.168.194-.338.217-.627.072-2.868-1.432-3.896-2.52-4.523-3.6-.168-.29-.018-.448.127-.592.13-.13.29-.338.434-.507.145-.168.193-.29.29-.483.096-.193.048-.362-.024-.507-.073-.145-.653-1.572-.895-2.152-.236-.569-.476-.491-.653-.5l-.558-.009c-.193 0-.507.072-.772.362-.266.29-1.014.99-1.014 2.415 0 1.425 1.038 2.802 1.182 2.995.145.193 2.044 3.12 4.952 4.378.692.301 1.232.48 1.653.614.697.222 1.332.19 1.833.116.558-.082 1.716-.7 1.958-1.376.242-.676.242-1.256.17-1.376-.073-.12-.267-.193-.558-.338z"/></svg>
        </div>
        <div class="w-10 h-10 rounded-full bg-white dark:bg-zinc-800 border border-hairline shadow-xs flex items-center justify-center hover:scale-110 transition-transform duration-200" title="Instagram">
          <svg class="w-5 h-5 text-pink-500" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051C.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Comparison Section: Static vs Dynamic -->
  <div class="flex flex-col gap-6">
    <div class="text-center flex flex-col gap-2 max-w-xl mx-auto">
      <h3 class="text-xl font-bold font-sans text-ink">
        {data.comparisonTitle}
      </h3>
      <p class="text-xs text-mute">
        {data.comparisonDesc}
      </p>
    </div>

    <div class="overflow-x-auto border border-hairline rounded-xl premium-shadow">
      <table class="w-full text-xs text-left border-collapse bg-canvas">
        <thead>
          <tr class="bg-gradient-to-r from-canvas-soft-2 to-canvas-soft border-b border-hairline text-ink font-semibold">
            <th class="px-5 py-4">{data.tableHeaders.feature}</th>
            <th class="px-5 py-4">{data.tableHeaders.staticQr}</th>
            <th class="px-5 py-4">{data.tableHeaders.dynamicQr}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline text-body font-sans text-xs">
          {data.comparisonRows.map((row) => (
            <tr class="hover:bg-canvas-soft-2/40 transition-colors">
              <td class="px-5 py-4 font-semibold text-ink bg-canvas-soft-2/10">{row.feature}</td>
              <td class="px-5 py-4 font-medium">
                {row.staticBadge ? (
                  <div class="flex items-center gap-1.5">
                    <span class={`${row.staticBadgeType === 'err' ? 'text-error font-extrabold text-sm' : 'text-success font-extrabold text-sm'}`}>
                      {row.staticBadgeType === 'err' ? '✗' : '✓'}
                    </span>
                    <span class="px-2 py-0.5 rounded-full text-[9px] font-semibold bg-zinc-100 dark:bg-zinc-800 text-zinc-500 whitespace-nowrap">
                      {row.staticBadge}
                    </span>
                  </div>
                ) : (
                  <span>{row.staticVal}</span>
                )}
              </td>
              <td class="px-5 py-4 font-medium">
                {row.dynamicBadge ? (
                  <div class="flex items-center gap-1.5">
                    <span class={`${row.dynamicBadgeType === 'warn' ? 'text-warning font-extrabold text-sm' : 'text-success font-extrabold text-sm'}`}>
                      {row.dynamicBadgeType === 'warn' ? '⚠' : '✓'}
                    </span>
                    <span class="px-2 py-0.5 rounded-full text-[9px] font-semibold bg-violet-100 dark:bg-violet-950/40 text-violet-600 dark:text-violet-400 whitespace-nowrap">
                      {row.dynamicBadge}
                    </span>
                  </div>
                ) : (
                  <span>{row.dynamicVal}</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    
    <p class="text-[11px] text-mute leading-relaxed">
      {data.comparisonNote}
    </p>
  </div>

  <!-- Bulk QR Code Generation -->
  <div class="bg-canvas border border-hairline rounded-xl p-8 shadow-sm flex flex-col gap-5 leading-relaxed">
    <h3 class="text-xl font-bold font-sans text-ink">
      {data.bulkTitle}
    </h3>
    <p class="text-xs text-body">
      {data.bulkP1}
    </p>
    <p class="text-xs text-body">
      {data.bulkP2}
    </p>
  </div>

  <!-- Developer API Integration -->
  <div class="bg-canvas border border-hairline rounded-xl p-8 shadow-sm flex flex-col gap-4 leading-relaxed">
    <h3 class="text-xl font-bold font-sans text-ink">
      {data.apiTitle}
    </h3>
    <p class="text-xs text-body">
      {data.apiP1}
    </p>
    <p class="text-xs text-body">
      {data.apiP2}
    </p>
  </div>

  <!-- User Benefits Card List -->
  <div class="flex flex-col gap-6">
    <h3 class="text-xl font-bold font-sans text-ink text-center">
      {data.whyUsTitle}
    </h3>
    
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-center">
      {data.benefits.map((b) => (
        <div class="bg-canvas border border-hairline rounded-lg p-5 shadow-xs flex flex-col gap-2">
          <span class="text-xs font-bold text-ink">{b.title}</span>
          <p class="text-[11px] text-body leading-relaxed">{b.desc}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Step-by-Step Guide -->
  <div class="flex flex-col gap-8 w-full mt-4">
    <div class="text-center flex flex-col gap-2 max-w-xl mx-auto">
      <h3 class="text-2xl font-bold font-sans tracking-tight text-ink">
        {data.guideTitle}
      </h3>
      <p class="text-xs text-mute leading-relaxed">
        {data.guideDesc}
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {data.steps.map((step) => (
        <div class="group bg-canvas border border-hairline hover:border-hairline-strong hover:-translate-y-1 transition-all duration-300 rounded-xl p-6 flex flex-col gap-4 shadow-xs hover:shadow-sm relative overflow-hidden">
          <div class="flex justify-between items-center">
            <div class="w-10 h-10 rounded-lg bg-canvas-soft border border-hairline flex items-center justify-center">
              <svg class="w-5 h-5 text-ink group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
              </svg>
            </div>
            <span class="text-3xl font-extrabold tracking-tight bg-gradient-to-r from-success to-violet bg-clip-text text-transparent opacity-80 font-mono">{step.number}</span>
          </div>
          <div>
            <h4 class="text-sm font-bold text-ink mb-1 group-hover:text-success transition-colors duration-200">
              {step.title}
            </h4>
            <p class="text-xs text-body leading-relaxed">
              {step.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>

</section>
