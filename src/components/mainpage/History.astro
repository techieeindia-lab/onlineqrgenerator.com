---
import { translations } from '../../i18n/translations';
import { getUiStrings } from '../../i18n/uiStrings';

const locale = Astro.currentLocale || 'en';
const t = translations[locale] || translations.en;
const ui = getUiStrings(locale);
---
  <section id="history" class="scroll-mt-24 border-t border-hairline pt-12 flex flex-col gap-6">
    <div class="flex items-center justify-between">
      <h2 class="text-2xl font-bold font-sans tracking-tight text-ink">{t.actions.historyTitle}</h2>
      <button id="clear-all-history-btn" class="hidden text-xs font-semibold text-error hover:text-error-deep cursor-pointer flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-error/15 bg-error/5 hover:bg-error/10 transition-all select-none border-0">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
        <span>{ui.history.clearHistory}</span>
      </button>
    </div>
    <div id="history-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <div id="history-empty" class="col-span-full border border-dashed border-hairline-strong/30 rounded-2xl p-12 text-center bg-canvas-soft-2/30 flex flex-col items-center justify-center gap-3 relative overflow-hidden">
        <svg class="w-8 h-8 text-mute" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <p class="text-sm text-mute">{t.actions.historyEmpty}</p>
      </div>
    </div>
  </section>
