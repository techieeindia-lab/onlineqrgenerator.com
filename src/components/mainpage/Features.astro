---
interface Props {
  landingPageData: {
    details: string;
    features: string[];
    [key: string]: any;
  };
}

const { landingPageData } = Astro.props;
---
    <section class="border-t border-hairline pt-12 grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
      <div class="md:col-span-6 flex flex-col gap-4">
        <h2 class="text-2xl font-bold font-sans tracking-tight text-ink">Why Use QR Codes?</h2>
        <p class="text-sm text-body leading-relaxed">{landingPageData.details}</p>
      </div>
      <div class="md:col-span-6 bg-canvas border border-hairline rounded-lg p-6 shadow-sm flex flex-col gap-4">
        <span class="text-xs font-mono uppercase tracking-wider text-mute">Key Features</span>
        <ul class="flex flex-col gap-3">
          {landingPageData.features.map(feat => (
            <li class="flex items-start gap-3 text-xs text-body">
              <svg class="w-4.5 h-4.5 text-success shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
              <span>{feat}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
